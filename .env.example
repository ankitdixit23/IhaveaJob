# Copy to .env and fill in locally. NEVER commit .env.
# Placeholders only: this file is public.

# Database. Leave unset for local SQLite at data/ihaveajob.db.
# For GitHub Actions, set this as the DATABASE_URL repository secret instead.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# Monitoring behaviour (defaults shown)
# IHAVEAJOB_CLOSE_AFTER_MISSES=3
# IHAVEAJOB_CLOSE_AFTER_HOURS=6
# IHAVEAJOB_MAX_DETAIL_FETCHES=25
# IHAVEAJOB_DETAIL_REFRESH_HOURS=24
# IHAVEAJOB_USER_AGENT=IhaveaJobBot/0.1 (+https://github.com/ankitdixit23/IhaveaJob)
# IHAVEAJOB_LOG_FORMAT=json
# IHAVEAJOB_LOG_LEVEL=INFO

# Email alerts (see docs/email.md). For GitHub Actions, set these as repository secrets.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=sender@example.com
# SMTP_PASSWORD=your-16-character-app-password
# SMTP_FROM=IhaveaJob <sender@example.com>
# ALERT_EMAIL_TO=you@example.com
# IHAVEAJOB_TIMEZONE=America/Los_Angeles
